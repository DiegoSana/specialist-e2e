# Base URLs for the three services the suite drives. Defaults match each repo's
# documented local dev port (see each repo's own CLAUDE.md).
E2E_API_URL=http://localhost:5000/api
E2E_FE_URL=http://localhost:3001
E2E_ADMIN_URL=http://localhost:3000

# Mailpit (local dev email catcher — Web UI + REST API). Only needed by
# password-reset.spec.ts, to read the emailed reset link. See
# specialist-be/docker-compose.dev.yml for the documented default ports.
E2E_MAILPIT_URL=http://localhost:8025

# Cleanup endpoint in specialist-be (dev-only, see /var/www/specialist plan for
# "specialist-e2e": section 2, endpoint not built yet as of this scaffold commit).
E2E_CLEANUP_ENDPOINT=http://localhost:5000/api/requests/test-utils/e2e-data

# Every Request this suite creates gets its title prefixed with this marker, so the
# cleanup endpoint (once it exists) can find and delete exactly what this suite created.
E2E_TITLE_PREFIX=[E2E]

# Set to 1 or true to skip the teardown cleanup and keep this run's data in the DB
# (e.g. to inspect it from specialist-admin). Unset by default.
# E2E_SKIP_CLEANUP=1
